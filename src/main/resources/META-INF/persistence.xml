<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="appPU" transaction-type="JTA">
        <!-- Criado pelo docker/configure-wildfly.cli -->
        <jta-data-source>java:jboss/datasources/AppDS</jta-data-source>
        <properties>
            <!-- Desenvolvimento: o Hibernate cria/ajusta as tabelas sozinho.
                 Em produção, troque por migrações (Flyway/Liquibase) e "validate" ou "none". -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
